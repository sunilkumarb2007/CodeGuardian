# Frontend Environment Configuration

# Local Development: Origin that the Vite dev server proxies /api and /health to.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# Production Deployment (Render Static Site): Set to public API URL (e.g., https://codeguardian-api.onrender.com)
# Leave empty in local dev to rely on Vite proxy.
VITE_API_BASE_URL=https://codeguardian-api.onrender.com
