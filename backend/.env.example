# Database Connection (PostgreSQL 17)
DATABASE_URL=postgresql+psycopg2://codeguardian:codeguardian_password@localhost:5433/codeguardian_db

# Redis Distributed Lock & Stream
REDIS_URL=redis://localhost:6379/0

# Application Configuration
APP_NAME=CodeGuardian
APP_ENV=development
DEBUG=true

# AI Investigation Provider (Sarvam AI)
AI_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b

# GitHub API Integration (Branch, Commit, PR creation)
GITHUB_TOKEN=your_github_personal_access_token

# Allowed Frontend Origin (for Production CORS)
FRONTEND_ORIGIN=https://codeguardian-web.onrender.com
